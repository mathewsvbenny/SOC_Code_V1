# Added by hand by Carmine Autieri

# Useful for molecule
#gamma_only : true
!translate_home_cell=true   # help in the future visualisation
!guiding_centres = true     # try to move the WF center to the projection center

# Option used also for bulk system

bands_plot= .true.
bands_num_points=100
begin kpoint_path
G   0.00000  0.00000  0.00000   M   0.50000  0.00000  0.00000   
M   0.50000  0.00000  0.00000   K   0.333333333333  0.333333333333333  0.00000   
K   0.333333333333  0.333333333333333  0.00000   G   0.00000  0.00000  0.00000   
end kpoint_path


#postproc_setup= .true.
num_iter=0    # 0 don't calcultae Maximally Localize
dis_num_iter=3800
iprint = 3
!trial_step=0.5
!wannier_plot_list=1,5

write_hr=.true.
!restart= wannierise
!restart=plot
!wannier_plot=.true.
!wannier_plot_supercell=3  ! 3 va male, 1 va bene ma ci sono i bordi proviamo 2
dis_win_min= -11
dis_win_max= 11
dis_froz_min= -11
dis_froz_max= 7.6

optimisation = 1  # speed

num_bands = 19
num_wann =  19

begin projections
Mn:dxy: x=1,0,0 : z=0,0,1
Mn:dyz: x=1,0,0 : z=0,0,1
Mn:dxz: x=1,0,0 : z=0,0,1
Mn:dx2-y2: x=1,0,0 : z=0,0,1
Mn:dz2: x=1,0,0 : z=0,0,1
Te:px: x=1,0,0 : z=0,0,1
Te:py: x=1,0,0 : z=0,0,1
Te:pz: x=1,0,0 : z=0,0,1
end projections

begin unit_cell_cart
    -2.0539175    -3.5574895     0.0000000
    -2.0539175     3.5574895     0.0000000
     0.0000000     0.0000000   -67.6734155
end unit_cell_cart
begin atoms_cart
Mn       0.0000000     0.0000000    -1.6918354
Mn       0.0000000     0.0000000   -65.9815801
Te      -2.0539175    -1.1858298   -64.2897447
Te      -2.0539175     1.1858298     0.0000000
Te      -2.0539175    -1.1858298    -3.3836708
end atoms_cart
mp_grid =    12    12     1
