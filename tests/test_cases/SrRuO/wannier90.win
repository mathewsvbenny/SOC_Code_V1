# Added by hand by Carmine Autieri

# Useful for molecule
#gamma_only : true
!translate_home_cell=true   # help in the future visualisation
!guiding_centres = true     # try to move the WF center to the projection center

# Option used also for bulk system

bands_plot= .true.
bands_num_points=100
begin kpoint_path
G  0.0000000000   0.0000000000   0.0000000000     X  0.5000000000   0.0000000000   0.0000000000 
X  0.5000000000   0.0000000000   0.0000000000     S  0.5000000000   0.5000000000   0.0000000000    
