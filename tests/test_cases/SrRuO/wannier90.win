end kpoint_path

#postproc_setup= .true.
num_iter=0    # 0 don't calcultae Maximally Localization
dis_num_iter=3800
iprint = 3
!trial_step=0.5
!wannier_plot_list=1,5

write_hr=.true.
!restart= wannierise
!restart=plot
!wannier_plot=.true.
!wannier_plot_supercell=3  ! 3 va male, 1 va bene ma ci sono i bordi proviamo 2
dis_win_min= 2.9
dis_win_max= 6.7
dis_froz_min= 3.8
dis_froz_max= 6.7

optimisation = 1  # speed

num_bands = 18
num_wann =  12

begin projections
Ru : dxy: x=1,1,0
Ru : dxz: x=1,1,0
Ru : dyz: x=1,1,0
end projections



